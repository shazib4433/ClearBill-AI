# ClearBill AI Environment Configuration
# Copy this file to .env and add your Gemini API key.
# Supports Google AI Studio keys (AIza... and AQ....) out of the box.
# Set GOOGLE_GENAI_USE_VERTEXAI=true only if explicitly targeting Vertex AI (aiplatform.googleapis.com).
# If GEMINI_API_KEY is omitted or left as placeholder, ClearBill AI automatically
# runs its transparent Demo Clinical Rule Engine fallback so offline demos still work.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_INGEST_MODEL=gemini-3.5-flash-lite
GEMINI_FUSION_MODEL=gemini-4-hydrogen

HIS_DB_PATH=database/mock_his.db
AUDIT_DB_PATH=database/clearbill_audit.db
